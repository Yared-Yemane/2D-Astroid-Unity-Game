:root {
}

.hidden {
    display: none;
    opacity: 0;
    visibility: hidden;
}

.container {
    flex-grow: 1;
}

.top-bar {
    flex-grow: 0;
    height: 75px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 25px;
}

.score-label {
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/Fonts/Roboto_Mono/static/RobotoMono-Bold.ttf?fileID=12800000&guid=ee84be2122354584e98b39b34fc06fe2&type=3#RobotoMono-Bold");
    -unity-text-align: upper-left;
    white-space: nowrap;
    height: 36px;
    width: 52px;
}

.score-value {
    color: rgb(255, 255, 255);
    padding-top: 5.5px;
}

.lives-icon {
    flex-grow: 1;
    height: 18px;
    width: 1px;
    background-image: url("project://database/Assets/Sprites/ship.png?fileID=-4360530552843628718&guid=4e82b219c9bc39d458882889e2d0d5f8&type=3#ship_0");
    background-size: 30% 80%;
    -unity-background-scale-mode: scale-to-fit;
}

.lives-value {
    height: 10px;
    font-size: 7px;
    position: relative;
    padding-top: 0;
    padding-left: 0;
    margin-left: 0;
    margin-top: 5px;
}

.spacer {
    flex-grow: 1;
    height: 18px;
    width: 535px;
    margin-top: 0;
}

.game-over-background {
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.95);
    align-items: center;
    justify-content: center;
}

.game-over-central-panel {
    flex-grow: 0;
    width: 280px;
    height: auto;
    position: relative;
    top: auto;
    left: auto;
    background-color: rgb(0, 0, 0);
    align-items: center;
    justify-content: center;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 16px;
    padding-right: 16px;
}

.game-over-label {
    -unity-font-definition: url("project://database/Assets/Fonts/Roboto_Mono/static/RobotoMono-Bold%20SDF.asset?fileID=11400000&guid=39e591fe7f5c4e745a78c5db7ca72e92&type=2#RobotoMono-Bold SDF");
    color: rgb(234, 116, 110);
    text-shadow: 0 0 0 rgb(107, 142, 35);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.button-panel {
    flex-grow: 0;
    width: 100%;
    height: auto;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
    margin-bottom: 0;
}

.button-label {
    color: rgb(232, 220, 220);
    -unity-font-definition: url("project://database/Assets/Fonts/Roboto_Mono/static/RobotoMono-Bold%20SDF.asset?fileID=11400000&guid=39e591fe7f5c4e745a78c5db7ca72e92&type=2#RobotoMono-Bold SDF");
    font-size: 12px;
    background-color: rgb(190, 57, 88);
    height: auto;
    width: auto;
    min-width: 180px;
    margin-top: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-right: 24px;
    padding-left: 24px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    -unity-text-align: middle-center;
    transition-property: scale;
    transition-duration: 0.2s;
}

.button-label:hover {
    background-color: rgb(255, 255, 255);
    border-left-color: rgb(195, 209, 30);
    border-right-color: rgb(195, 209, 30);
    border-top-color: rgb(195, 209, 30);
    border-bottom-color: rgb(195, 209, 30);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    color: rgb(5, 4, 4);
    -unity-slice-scale: 1px;
    scale: 1.05 1.05;
}

.button-label:active {
    border-left-color: rgb(0, 159, 21);
    border-right-color: rgb(0, 159, 21);
    border-top-color: rgb(0, 159, 21);
    border-bottom-color: rgb(0, 159, 21);
}

.top-score-label {
}

.your-score-label {
}
